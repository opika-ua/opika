# Every environment variable the app reads, and whether it's required.
# No real values below — copy this file to .env.local and fill in your own.

# Required. Postgres connection string. Locally this matches docker-compose.yml.
# In production/preview (Vercel), this must be a real, internet-reachable
# Postgres — Vercel's build and runtime cannot reach a "localhost" URL on
# your machine. See docs/build-plan.md's Neon setup notes for the
# pooled-vs-direct distinction serverless needs.
# Throws at boot in production if unset (apps/web/src/instrumentation.ts) and
# at first use everywhere else (apps/web/src/api/env.ts's requireEnv).
DATABASE_URL=postgresql://opika:opika@localhost:5432/opika

# Required. Signs feed and reveal pagination cursors (HMAC-SHA256) so a
# client can't forge one to skip ahead, reuse a cursor across a changed
# filter set, or reuse a feed cursor as a reveal cursor. Generate a real
# value with: openssl rand -hex 32
# Throws at boot in production if unset, and at first use (any feed.list or
# reveals.list call) everywhere else — see apps/web/src/api/env.ts.
CURSOR_HMAC_SECRET=

# Not read by the app today. Reserved for the HMAC key that will drive
# per-shelter location fuzzing (packages/db/src/location-policy.ts,
# CLAUDE.md decision #15) once a real shelter-onboarding path exists.
# packages/db/src/seed.ts currently uses a test-only, unkeyed, publicly
# reversible policy instead — correct for fictional seed data, and NOT
# something that may ever compute a real foster carer's public location.
# Must be wired to a real handler, and added to
# apps/web/src/api/env.ts's required-secrets schema, in the same change
# that lets real shelter data enter the system — see docs/build-plan.md's
# launch-gate list. Not required for this deploy.
# LOCATION_HMAC_SECRET=

# Set automatically by Next.js / Vercel — never set this yourself. Governs
# the session cookie's __Host- prefix and Secure attribute
# (apps/web/src/api/session/cookie.ts) and this app's own boot-time secrets
# check (apps/web/src/api/env.ts's validateEnv, production only).
# NODE_ENV=production
