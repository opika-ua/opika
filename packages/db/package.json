{
  "name": "@opika/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts",
    "./repos": "./src/repos/index.ts",
    "./test": "./src/test-utils/index.ts",
    "./image-pipeline": "./src/image-pipeline/index.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/migrate.ts",
    "db:seed": "tsx src/seed.ts",
    "onboard:shelter": "tsx src/onboard-shelter.ts",
    "test-db:ensure": "tsx src/test-utils/ensure-test-database.ts",
    "db:check-hashes": "tsx src/check-migration-hashes.ts",
    "location:verify": "tsx src/verify-locations.ts",
    "admin:bootstrap": "tsx src/admin.ts bootstrap",
    "admin:grant": "tsx src/admin.ts grant",
    "admin:revoke": "tsx src/admin.ts revoke",
    "admin:sweep-invites": "tsx src/admin.ts sweep-invites",
    "db:neon-smoke": "tsx test/neon-smoke.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "catalog:",
    "@neondatabase/serverless": "catalog:",
    "@opika/domain": "workspace:*",
    "drizzle-orm": "catalog:",
    "postgres": "catalog:",
    "sharp": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@opika/contracts": "workspace:*",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "drizzle-kit": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
