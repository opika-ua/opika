exports[`feed.list generated SQL is unchanged by the shared-predicate extraction > a single age bucket, which takes the un-OR'd branch 1`] = `
{
  "parameters": [
    "published",
    "reserved",
    "verified",
    "2018-08-05T13:26:24.000Z",
    "21",
  ],
  "query": "select "id", "shelter_id", "name", "species", "sex", "size", "age", "age_anchor_at", "wait_anchor_at", "description_uk", "description_en_text", "description_en_provenance", "photos", "vaccination", "spay_neuter", "document_readiness", "listing", "listing_kind", "public_location", "city_id", "created_at", "last_updated_at" from "animals" where ("animals"."listing_kind" in ($1, $2) and "animals"."shelter_id" IN ( SELECT "shelters"."id" FROM "shelters" WHERE "shelters"."verification_status" in ($3) ) and "animals"."age_anchor_at" <= $4::timestamptz) order by "animals"."last_updated_at" desc, "animals"."id" limit $5",
}
`;

