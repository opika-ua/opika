# Repo-root seed-photos/ from db:seed's old per-animal synthetic JPEG
# generator (removed — see packages/db/src/seed.ts). Nothing writes here
# any more, but the pattern stays in case a checkout still has stale local
# files from before. Anchored to the repo root (leading /) specifically so
# it does NOT also match apps/web/public/seed-photos/ — that one holds a
# single real, deliberately committed placeholder image the app actually
# serves, not disposable generated output.
/seed-photos/

# Playwright harness output: failure screenshots, traces, HTML report.
# Regenerated on every run; the assertions are the artefact worth keeping.
test-results/
playwright-report/

# Isolated git worktrees created for background agent runs (Agent tool,
# isolation: "worktree"). Ephemeral scratch space, not repo content.
.claude/worktrees/

# Next.js's own scaffolded agent-context files (next dev auto-writes these
# under any app the moment it detects an AI coding agent — verified against
# node_modules/next/dist/server/lib/generate-agent-files.js). Content is a
# generic "read the bundled docs, this Next version may differ from your
# training data" disclaimer, not project instructions — the real ones are
# the root CLAUDE.md and docs/standing-constraints.md. Ignored rather than
# committed so `next dev` doesn't reintroduce them into every future diff.
apps/*/AGENTS.md
apps/*/CLAUDE.md
